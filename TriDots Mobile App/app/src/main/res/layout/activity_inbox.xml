<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_default"
    tools:context=".main_screens.InboxActivity">

    <!-- App Bar for a consistent header -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_green">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Inbox"
            app:titleTextColor="@android:color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="80dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewChatList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_chat_room" />

        <TextView
            android:id="@+id/textViewNoChats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="No active chats yet.\nStart a conversation!"
            android:textAlignment="center"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>


    <!-- Custom Animated Bottom Navigation -->
    <FrameLayout
        android:id="@+id/customBottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="83dp"
            android:background="@drawable/bottom_nav_background"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp">

            <!-- Home Tab -->
            <LinearLayout
                android:id="@+id/navHome"
                style="@style/BottomNavItemStyle">
                <ImageView
                    android:id="@+id/iconHome"
                    style="@style/BottomNavIconStyle"
                    android:src="@drawable/ic_home" />
                <TextView
                    android:id="@+id/labelHome"
                    style="@style/BottomNavLabelStyle"
                    android:text="Home" />
                <View
                    android:id="@+id/indicatorHome"
                    style="@style/BottomNavIndicatorStyle" />
            </LinearLayout>

            <!-- Dashboard Tab -->
            <LinearLayout
                android:id="@+id/navDashboard"
                style="@style/BottomNavItemStyle">
                <ImageView
                    android:id="@+id/iconDashboard"
                    style="@style/BottomNavIconStyle"
                    android:src="@drawable/ic_dashboard" />
                <TextView
                    android:id="@+id/labelDashboard"
                    style="@style/BottomNavLabelStyle"
                    android:text="Dashboard" />
                <View
                    android:id="@+id/indicatorDashboard"
                    style="@style/BottomNavIndicatorStyle" />
            </LinearLayout>

            <!-- Marketplace Tab (Center FAB style) -->
            <LinearLayout
                android:id="@+id/navMarketplace"
                style="@style/BottomNavItemStyle">
                <androidx.cardview.widget.CardView
                    style="@style/BottomNavFabStyle">
                    <ImageView
                        android:id="@+id/iconMarketplace"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_marketplace"
                        app:tint="@android:color/white" />
                </androidx.cardview.widget.CardView>
                <TextView
                    android:id="@+id/labelMarketplace"
                    style="@style/BottomNavLabelStyle"
                    android:text="Marketplace"
                    android:textColor="@color/primary_green"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Inbox Tab -->
            <LinearLayout
                android:id="@+id/navInbox"
                style="@style/BottomNavItemStyle">
                <ImageView
                    android:id="@+id/iconInbox"
                    style="@style/BottomNavIconStyle"
                    android:src="@drawable/ic_inbox" />
                <TextView
                    android:id="@+id/labelInbox"
                    style="@style/BottomNavLabelStyle"
                    android:text="Inbox" />
                <View
                    android:id="@+id/indicatorInbox"
                    style="@style/BottomNavIndicatorStyle" />
            </LinearLayout>

            <!-- Profile Tab -->
            <LinearLayout
                android:id="@+id/navProfile"
                style="@style/BottomNavItemStyle">
                <ImageView
                    android:id="@+id/iconProfile"
                    style="@style/BottomNavIconStyle"
                    android:src="@drawable/ic_profile" />
                <TextView
                    android:id="@+id/labelProfile"
                    style="@style/BottomNavLabelStyle"
                    android:text="Profile" />
                <View
                    android:id="@+id/indicatorProfile"
                    style="@style/BottomNavIndicatorStyle" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
