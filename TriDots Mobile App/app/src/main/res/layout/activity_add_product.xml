<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Marketplace.AddProductActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add New Product to Marketplace"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Category Spinner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/btn_dropdown"
            android:spinnerMode="dropdown" />

        <!-- Product Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:hintEnabled="true"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Product Name"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Product Description -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:hintEnabled="true"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextProductDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Product Description"
                android:inputType="textMultiLine"
                android:lines="4"
                android:gravity="top|start" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Price -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:hintEnabled="true"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Price (LKR)"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Stock Quantity -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:hintEnabled="true"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextStockQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Stock Quantity"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Product Condition -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Product Condition"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />
        <RadioGroup
            android:id="@+id/radioGroupProductCondition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <RadioButton
                android:id="@+id/radioButtonNew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New"
                android:checked="true"/>
            <RadioButton
                android:id="@+id/radioButtonUsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Used"/>
        </RadioGroup>

        <!-- SKU (Optional) -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:hintEnabled="true"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextSku"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="SKU (Optional)"
                android:inputType="textCapCharacters" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Brand (Optional) -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:hintEnabled="true"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextBrand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Brand (Optional)"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Model (Optional) -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:hintEnabled="true"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Model (Optional)"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Color (Optional) -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:hintEnabled="true"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Color (Optional)"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Keywords (Optional) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutKeywords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:hintEnabled="true"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextKeywords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Keywords (comma-separated, Optional)"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Compatibility (New Field) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutCompatibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:hintEnabled="true"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextCompatibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Compatibility (Optional)"
                android:inputType="textMultiLine"
                android:lines="3"
                android:gravity="top|start" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Warranty Policy (Optional) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutWarrantyPolicy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:hintEnabled="true"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextWarrantyPolicy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Warranty Policy (Optional)"
                android:inputType="textMultiLine"
                android:lines="3"
                android:gravity="top|start" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Weight (g) (Optional) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:hintEnabled="true"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Weight (grams, Optional)"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Dimensions (cm) (Optional) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutDimensions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:hintEnabled="true"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextDimensions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Dimensions (e.g., LxWxH in cm, Optional)"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Material (New Field) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutMaterial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:hintEnabled="true"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextMaterial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Material (Optional)"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Manufacturing Date (New Field) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutManufacturingDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:hintEnabled="true"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextManufacturingDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Manufacturing Date (YYYY-MM-DD, Optional)"
                android:inputType="date"
                android:focusable="false"
                android:clickable="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Expiration Date (New Field) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayoutExpirationDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:hintEnabled="true"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextExpirationDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Expiration Date (YYYY-MM-DD, Optional)"
                android:inputType="date"
                android:focusable="false"
                android:clickable="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Main Product Image (New Section) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Main Product Image (Optional)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <ImageView
            android:id="@+id/imageViewMainProductPreview"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            android:background="@android:color/darker_gray"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:contentDescription="Main Product Image Preview" />

        <Button
            android:id="@+id/buttonSelectMainProductImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Main Image"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />


        <!-- Store Address Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Store Address"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:hintEnabled="true"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextStoreAddressLine1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Store Address Line 1"
                android:inputType="textPostalAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:hintEnabled="true"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextStoreAddressLine2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Store Address Line 2 (Optional)"
                android:inputType="textPostalAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:hintEnabled="true"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextStoreCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Store City"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:hintEnabled="true"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextStoreDistrict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Store District"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:hintEnabled="true"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextStorePostalCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Store Postal Code"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:hintEnabled="true"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextStoreCountry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Store Country"
                android:inputType="textCapWords"
                android:text="Sri Lanka" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:hintEnabled="true"
            app:hintTextColor="?attr/colorPrimary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextDeliveryFee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Delivery Fee (Optional)"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:id="@+id/linearLayoutVariantsContainerParent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Product Variants"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/linearLayoutVariantsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="@drawable/rounded_border_background"
                android:minHeight="50dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No variants added yet."
                    android:padding="8dp"/>
            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/buttonAddVariant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Variants"
            android:backgroundTint="@android:color/holo_blue_dark"
            android:textColor="@android:color/white"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/buttonAddProduct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Product"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="@android:color/white"
            android:padding="12dp"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>
