<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Marketplace.MarketplaceListFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewMarketplaceProductList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:listitem="@layout/item_marketplace_product" /> <!-- We will create this item layout next -->

    <TextView
        android:id="@+id/textViewMarketplaceEmptyList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No products found for this status."
        android:textSize="18sp"
        android:visibility="gone"
        android:layout_gravity="center" />

</FrameLayout>
