<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".main_screens.ManageMarketplaceActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/textViewManageMarketplaceTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Manage My Marketplace"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonAddNewProduct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add New Product"
            android:backgroundTint="?attr/colorPrimaryVariant"
            android:textColor="@android:color/white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:drawableStart="@android:drawable/ic_input_add"
            android:drawablePadding="8dp" />

    </LinearLayout>

    <!-- TabLayout for different product approval statuses -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutMarketplace"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="scrollable"
        app:tabGravity="fill"
        android:background="?attr/colorPrimary"
        app:tabTextColor="@android:color/white"
        app:tabSelectedTextColor="@android:color/white"
        app:tabIndicatorColor="@android:color/white" />

    <!-- ViewPager2 to swipe between product lists for different statuses -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerMarketplaceProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/textViewNoMarketplaceProducts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No products found for this status."
        android:textSize="18sp"
        android:visibility="gone"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"/>

</LinearLayout>
