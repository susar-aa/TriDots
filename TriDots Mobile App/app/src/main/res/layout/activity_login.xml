<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:id="@+id/top_white_section"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_curved_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4" >

        <ImageView
            android:id="@+id/user_icon_image"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="50dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="User Icon"
            android:src="@drawable/icons8_login_100" />

        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
            android:fontFamily="@font/sf_pro_display_bold"
        android:layout_marginBottom="32dp"
        android:text="Log in to TriDots"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:fontFamily="@font/sf_pro_display_regular"
            android:layout_marginBottom="8dp"
            android:text="Email Address"
            android:textColor="@android:color/black"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/edit_text_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sf_pro_display_regular"
            android:layout_marginBottom="24dp"
            android:background="@drawable/edit_text_background"
            android:hint="Enter Email"
            android:inputType="textEmailAddress"
            android:padding="16dp"
            android:textColorHint="#B3B3B3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sf_pro_display_regular"
            android:layout_gravity="start"
            android:layout_marginBottom="8dp"
            android:text="Password"
            android:textColor="@android:color/black"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/edit_text_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:background="@drawable/edit_text_background"
            android:fontFamily="@font/sf_pro_display_regular"
            android:hint="Enter Password"
            android:inputType="textPassword"
            android:padding="16dp"
            android:textColorHint="#B3B3B3" />

    </LinearLayout>

    <View
        android:id="@+id/bottom_curved_bg"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:background="@drawable/curved_top_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_white_section" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="@id/bottom_curved_bg"
        app:layout_constraintEnd_toEndOf="@id/bottom_curved_bg"
        app:layout_constraintStart_toStartOf="@id/bottom_curved_bg"
        app:layout_constraintTop_toTopOf="@id/bottom_curved_bg"
        app:layout_constraintVertical_bias="0.3">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_login"
            android:layout_width="238dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sf_pro_display_medium"
            android:layout_marginBottom="24dp"
            android:background="@drawable/white_button_background"
            android:padding="16dp"
            android:text="Login"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_forgot_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sf_pro_display_regular"
            android:text="Forgot Password"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="italic" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>