<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Product Image Thumbnail -->
        <ImageView
            android:id="@+id/imageViewProductThumbnail"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            android:background="@android:color/darker_gray"
            android:layout_marginEnd="16dp"
            android:contentDescription="Product Thumbnail" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textViewProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="16sp"
                android:text="Product Name"
                android:textColor="@android:color/black"/>

            <TextView
                android:id="@+id/textViewProductPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Price: LKR 0.00"
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/textViewProductStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: Active"
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/textViewApprovedStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Approval: Pending"
                android:textSize="14sp"
                android:textStyle="italic"
                android:textColor="@android:color/holo_orange_dark"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- Options Button (e.g., Edit, Delete, View Details) -->
        <ImageButton
            android:id="@+id/imageButtonOptions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_more"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Product Options"
            android:padding="8dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
